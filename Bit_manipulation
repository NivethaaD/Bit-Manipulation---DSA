1. Check K-th Bit

class Solution:
    def checkKthBit(self, n, k):
        for i in range(k):
            n = n // 2

        return n % 2 == 1

2. Number of Even and Odd Bits

class Solution:
    def evenOddBit(self, n: int) -> List[int]:
        ind = 0
        even = 0
        odd = 0
        while n:
            currentBit = n % 2
            n = n // 2

            if ind % 2 == 0:
                even = even+currentBit
            else:
                odd = odd+currentBit
            
            ind = ind + 1
        return [even, odd]

3. Counting Bits

class Solution:
    def countBits(self, n: int) -> List[int]:
        ans = [0]*(n+1)
        for i in range(1,n+1):
            ans[i] = ans[i//2] + i%2
        return ans

4. Power of Two

class Solution:
    def isPowerOfTwo(self, n: int) -> bool:
        if n<=0:
            return False
        
        while n%2==0:
            n = n // 2

        return n == 1

5. Set the rightmost unset bit

class Solution:
    def setBit(self, n):
        temp = n
        pos = 0
        
        while n>0:
            bit = n%2
            if bit == 0:
                return temp + (2**pos)
            
            n = n // 2
            pos = pos+1
        
        return temp + (2**pos)

6. All Divisors of a Number

import math
class Solution:
    def getDivisors(self, n):
        ans = []

        for i in range(1, int(math.sqrt(n))+1):
            if n % i == 0:
                ans.append(i)
                if (n // i) != i:
                    ans.append(n//i)
        ans.sort()
        return ans
