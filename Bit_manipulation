1. Check K-th Bit

class Solution:
    def checkKthBit(self, n, k):
        for i in range(k):
            n = n // 2

        return n % 2 == 1

2. Number of Even and Odd Bits

class Solution:
    def evenOddBit(self, n: int) -> List[int]:
        ind = 0
        even = 0
        odd = 0
        while n:
            currentBit = n % 2
            n = n // 2

            if ind % 2 == 0:
                even = even+currentBit
            else:
                odd = odd+currentBit
            
            ind = ind + 1
        return [even, odd]

3. Counting Bits

class Solution:
    def countBits(self, n: int) -> List[int]:
        ans = [0]*(n+1)
        for i in range(1,n+1):
            ans[i] = ans[i//2] + i%2
        return ans

